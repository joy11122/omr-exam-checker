MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=omr_exam_checker
# Production APP_URL must be the canonical HTTPS deployment URL.
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters
AUTH_URL=http://localhost:3000
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Public Google Web OAuth client ID used by native Android Credential Manager.
NEXT_PUBLIC_GOOGLE_WEB_CLIENT_ID=
APP_URL=http://localhost:3000
RESEND_API_KEY=
RESULTS_FROM_EMAIL=OMR Exam Checker <results@example.com>
# Optional private FastAPI service connection.
OMR_ENGINE_URL=
OMR_ENGINE_API_KEY=
