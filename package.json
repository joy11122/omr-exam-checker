{
  "name": "omr-exam-checker",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @omr/web",
    "build:web": "npm run build --workspace @omr/web",
    "lint:web": "npm run lint --workspace @omr/web",
    "typecheck:web": "npm run typecheck --workspace @omr/web",
    "test:grading": "node --experimental-strip-types --test apps/web/src/lib/grading/scoring.test.mjs",
    "test:analytics": "node --experimental-strip-types --test apps/web/src/lib/analytics/rankings.test.mjs",
    "test:billing": "node --experimental-strip-types --test apps/web/src/lib/billing/plans.test.mjs",
    "test:reports": "node --experimental-strip-types --test apps/web/src/lib/analytics/report-filters.test.mjs",
    "test:security": "node --experimental-strip-types --test apps/web/src/lib/security/*.test.mjs",
    "check:web": "npm run lint:web && npm run typecheck:web && npm run test:grading && npm run test:analytics && npm run test:billing && npm run test:reports && npm run test:security && npm run test:native && npm run build:web",
    "android:add": "cap add android && node scripts/android-configure.mjs",
    "android:sync": "node scripts/android-configure.mjs && cap sync android",
    "android:open": "cap open android",
    "android:build": "npm run android:sync && node scripts/android-build.mjs",
    "test:native": "node --experimental-strip-types --test apps/web/src/components/native/native-app-bridge.test.mjs"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.3"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.3"
  }
}
